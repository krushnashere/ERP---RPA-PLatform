# ── Enterprise ERP & RPA Automation Platform — backend configuration ──────────
# Copy to `.env` and adjust. Every value has a working default, so the app runs
# with no .env at all (SQLite + dev secret) — but never ship the defaults.

# --- app ---
APP_NAME="Enterprise ERP & RPA Automation Platform"
ENVIRONMENT=development            # development | staging | production
API_V1_PREFIX=/api/v1
DEBUG=true                         # false in production: hides stack traces

# --- database ---
# SQLite for local dev and the test suite. Production is PostgreSQL — the code
# is dialect-aware (row locking uses FOR UPDATE SKIP LOCKED only on Postgres):
#   DATABASE_URL=postgresql+psycopg2://erp:erp@localhost:5432/erp_rpa
DATABASE_URL=sqlite:///./erp_rpa.db
DB_ECHO=false                      # true logs every SQL statement

# --- security ---
# Generate a real one:  openssl rand -hex 32
JWT_SECRET_KEY=change-me-in-production-please-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# --- CORS (comma-separated, no trailing slash) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- file uploads (swap for S3/GCS in production) ---
UPLOAD_DIR=./uploads

# --- RPA worker ---
RPA_MAX_ATTEMPTS=3                 # then the job is dead-lettered
RPA_BACKOFF_BASE_SECONDS=2.0       # retry delay = base ^ attempts, capped
RPA_LEASE_SECONDS=120              # how long a worker owns a job before it is
                                   # considered crashed and swept back
RPA_POLL_INTERVAL_SECONDS=1.0
RPA_WORKER_CONCURRENCY=2           # jobs claimed per worker loop

# --- bootstrap admin (seed script / first run only) ---
BOOTSTRAP_ADMIN_EMAIL=admin@acme-erp.com
BOOTSTRAP_ADMIN_PASSWORD=Admin@123
